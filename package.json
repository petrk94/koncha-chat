{
  "name": "koncha-chat",
  "private": true,
  "version": "0.8.0-alpha.1",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "serve": "php -S 127.0.0.1:8787 -t public",
    "ai:build": "node scripts/build-local-ai.mjs",
    "ai:verify": "node scripts/verify-local-ai.mjs",
    "crypto:build": "wasm-pack build crypto-wasm --target web --out-dir ../public/vendor/olm --out-name koncha_olm --release --no-opt"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Koncha – privacy-first intercultural messenger proof of concept",
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "esbuild": "0.25.12",
    "wasm-pack": "0.15.1"
  }
}
